# GitHub GraphQL API requires an authenticated request even for public
# data. Create a classic personal access token at
# https://github.com/settings/tokens (no scopes are required to read
# public profile/contribution data — "read:user" is a safe minimal
# choice if you want to select something explicit) and paste it below.
#
# Server-only: this is read in src/lib/github/client.ts and must never be
# exposed to the browser (no NEXT_PUBLIC_ prefix, never referenced from
# client components).
GITHUB_TOKEN=

# Optional: override the GitHub GraphQL request timeout (milliseconds).
# GITHUB_API_TIMEOUT_MS=8000
